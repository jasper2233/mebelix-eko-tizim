# ==============================================================================
# Application
# ==============================================================================
APP_NAME="MebeliX"
ENVIRONMENT="local" # local, staging, production

# ==============================================================================
# Security / JWT
# ==============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY="secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_SERVER="localhost" # Use "db" for Docker
POSTGRES_PORT=5432
# Eski o'rnatishlarda "fastapi" bo'lishi mumkin — mavjud .env dagi qiymatni saqlang.
POSTGRES_DB="fastapi_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==============================================================================
# Redis
# ==============================================================================
REDIS_HOST="localhost" # Use "redis" for Docker
REDIS_PORT=6379

# ==============================================================================
# Rate limiting
# ==============================================================================
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_PERIOD=300

# ==============================================================================
# Pagination
# ==============================================================================
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# ==============================================================================
# Startup probes (DB / Redis health on lifespan)
# ==============================================================================
STARTUP_RETRY_MAX_ATTEMPTS=5
STARTUP_RETRY_DELAY_SECONDS=2

# ==============================================================================
# Threadpool (AnyIO sync-bridge slots)
# ==============================================================================
THREADPOOL_TOKENS=100

# ==============================================================================
# Reverse-proxy trust
# ==============================================================================
# JSON list of upstream IPs whose X-Forwarded-* headers to trust — vergul bilan
# ajratilgan qiymat ilovani ishga tushishida yiqitadi (pydantic list[str] ni JSON deb o'qiydi).
# XFF ishonchi. `*` QO'YMANG — u eng chap (mijoz bergan) qiymatni oladi va
# login rate-limiti header almashtirish bilan aylanib o'tiladi. Docker compose
# tarmog'i uchun standart: ["172.16.0.0/12"]
# Ikkinchi qatlam: gunicorn --forwarded-allow-ips flagi (docker-compose.prod.yml
# `api.command`) alohida GUNICORN_FORWARDED_ALLOW_IPS bilan boshqariladi —
# birini o'zgartirsang ikkinchisini ham moslashtir.
FORWARDED_ALLOW_IPS=["172.16.0.0/12"]
#GUNICORN_FORWARDED_ALLOW_IPS=172.16.0.0/12

# ==============================================================================
# First admin user (created on startup)
# ==============================================================================
ADMIN_PHONE="+998901234567"  # E.164 Uzbek mobile, no spaces
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="!Ch4ng3Th1sP4ssW0rd!"

# ==============================================================================
# CORS (JSON format)
# ==============================================================================
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ==============================================================================
# Frontend
# ==============================================================================
# Reverse proxy ortida BO'SH qoldiring: SDK yo'llari allaqachon /api/v1 bilan boshlanadi,
# shuning uchun bu yerdagi /api so'rovni /api/api/v1 ga aylantirib 404 beradi.
# Lokal dev uchun to'liq URL (backend boshqa portda).
VITE_API_URL="http://localhost:8000"
# Axios request timeout in milliseconds.
VITE_API_TIMEOUT_MS=30000

# ==============================================================================
# Docker (Production)
# ==============================================================================
# Number of Gunicorn workers: (2 * CPU cores) + 1 is typical.
GUNICORN_WORKERS=4
# Caddy listener. `:80` = plain HTTP. Set to a domain (e.g. `your-domain.com`)
# and Caddy will provision a Let's Encrypt cert automatically.
SITE_ADDRESS=:80

# Caddy host port binding (docker-compose.prod.yml, scripts/deploy.sh o'qiydi).
# Default 80/443 — Caddy to'g'ridan-to'g'ri internetga qaraydi. Mavjud host-nginx
# (ISPmanager) ortida ishlaganda loopback'ka o'tkazing, TLS'ni nginx tugatadi
# (qarang: docs/07-infra-devops.md), masalan: 127.0.0.1:8200 va 127.0.0.1:8443.
# CADDY_HTTP_BIND=80
# CADDY_HTTPS_BIND=443

# Yorliq chop etish (TZ 12.3/13.2): tsexdagi bridge-agent USB GoDEX'ga chiqaradi.
# G500-U'da tarmoq porti yo'q — printer IP'si yo'q, faqat agent.
# Printerlar admin paneldan ("Printer agentlar") ulanadi va har biri o'z tokenini
# oladi — bu qiymat bo'sh bo'lsa ham chop etish ishlaydi.
BRIDGE_TOKEN=""  # legacy: eski agentlar uchun umumiy token, ixtiyoriy
