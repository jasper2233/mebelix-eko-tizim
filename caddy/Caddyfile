# `SITE_ADDRESS` controls the listener and TLS behaviour:
#   - default `:80`           → plain HTTP, suitable for local containers behind another proxy.
#   - `your-domain.com`       → Caddy provisions a Let's Encrypt cert automatically, listens on :443.
#   - `your-domain.com:8443`  → custom port, Caddy still provisions TLS for the host name.
{$SITE_ADDRESS::80} {
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
	}

	encode gzip

	# Host passthrough, X-Forwarded-For va X-Forwarded-Proto'ni Caddy reverse_proxy
	# o'zi qo'yadi — qo'lda `header_up` yozish shart emas.
	handle /api* {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}

	handle /redoc* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Prometheus metrics tashqariga UMUMAN chiqmaydi.
	# Ilgari bu yerda `remote_ip private_ranges` matcher turardi, lekin prodda
	# Caddy host-nginx ORTIDA ishlaydi: har bir tashqi so'rovning `remote_host`i
	# proxy'ning o'zi (127.0.0.1 / docker bridge), ya'ni private range — matcher
	# hech kimni to'smasdi va metrikalar ochiq internetda edi.
	# Scraper qo'shilsa u compose tarmog'i ichidan `api:8000/metrics` ga boradi,
	# bu yo'ldan emas.
	handle /metrics {
		respond "Forbidden" 403
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Docker healthcheck uchun doimiy HTTP endpoint — SITE_ADDRESS TLS'ga o'tganda ham ishlaydi.
:8080 {
	respond /healthz "OK" 200
}
