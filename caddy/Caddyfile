# `SITE_ADDRESS` controls the listener and TLS behaviour:
#   - default `:80`           → plain HTTP, suitable for local containers behind another proxy.
#   - `your-domain.com`       → Caddy provisions a Let's Encrypt cert automatically, listens on :443.
#   - `your-domain.com:8443`  → custom port, Caddy still provisions TLS for the host name.
{$SITE_ADDRESS::80} {
	# Security headers
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		X-XSS-Protection "1; mode=block"
	}

	# Compression
	encode gzip

	# Backend API routes
	# Host passthrough, X-Forwarded-For va X-Forwarded-Proto'ni Caddy reverse_proxy
	# o'zi qo'yadi — faqat default bo'lmagan X-Real-IP qoladi.
	handle /api* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# API documentation routes
	handle /docs* {
		reverse_proxy api:8000
	}

	handle /redoc* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Prometheus metrics — faqat ichki/private tarmoqdan (scraper shu yerdan keladi).
	@internal_metrics {
		path /metrics
		remote_ip private_ranges
	}
	handle @internal_metrics {
		reverse_proxy api:8000
	}
	handle /metrics {
		respond "Forbidden" 403
	}

	# Frontend application
	handle {
		reverse_proxy frontend:80 {
			header_up X-Real-IP {remote_host}
		}
	}
}

# Docker healthcheck uchun doimiy HTTP endpoint — SITE_ADDRESS TLS'ga o'tganda ham ishlaydi.
:8080 {
	respond /healthz "OK" 200
}
