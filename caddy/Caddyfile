# `SITE_ADDRESS` controls the listener and TLS behaviour:
#   - default `:80`           → plain HTTP, suitable for local containers behind another proxy.
#   - `your-domain.com`       → Caddy provisions a Let's Encrypt cert automatically, listens on :443.
#   - `your-domain.com:8443`  → custom port, Caddy still provisions TLS for the host name.
{$SITE_ADDRESS::80} {
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
	}

	encode gzip

	# Host passthrough, X-Forwarded-For va X-Forwarded-Proto'ni Caddy reverse_proxy
	# o'zi qo'yadi — qo'lda `header_up` yozish shart emas.
	# UPAKOFKA POSTLARI (saralash / qadoqlash / saralash bo'limidagi TV) bir-biri bilan
	# reja va saralash holatini almashadi. Ularning sahifasi NISBIY manzil so'raydi
	# (`SRV.base = "api/"`), ya'ni `/upakofka/api/ping`. MES o'sha protokolni bajaradi
	# (`api/routes/upakofka_srv.py`), shuning uchun tsexga alohida server kerak emas.
	# `handle_path` prefiksni olib tashlaydi: `/upakofka/api/plans/7CAF3A` -> `/plans/7CAF3A`.
	#
	# Bu blok `main` ga ATAYLAB alohida chiqarildi: Caddy konfigi FAQAT prod stekidan
	# o'qiladi, ya'ni `dev.mebelix.uz` dagi upakofka ham shu fayl bilan ishlaydi
	# (2026-11-05 dagi kroy.caddy uzilishining saboqi — docs/07).
	handle_path /upakofka/api/* {
		rewrite * /api/v1/upakofka/srv{uri}
		reverse_proxy api:8000
	}

	handle /api* {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}

	handle /redoc* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Prometheus metrics tashqariga UMUMAN chiqmaydi.
	# Ilgari bu yerda `remote_ip private_ranges` matcher turardi, lekin prodda
	# Caddy host-nginx ORTIDA ishlaydi: har bir tashqi so'rovning `remote_host`i
	# proxy'ning o'zi (127.0.0.1 / docker bridge), ya'ni private range — matcher
	# hech kimni to'smasdi va metrikalar ochiq internetda edi.
	# Scraper qo'shilsa u compose tarmog'i ichidan `api:8000/metrics` ga boradi,
	# bu yo'ldan emas.
	handle /metrics {
		respond "Forbidden" 403
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Qo'shimcha saytlar (hozircha dev.mebelix.uz) — alohida fayllarda, prod bloki
# tegilmasin uchun. Fayl bo'lmasa import jim o'tadi.
import /etc/caddy/conf.d/*.caddy

# Docker healthcheck uchun doimiy HTTP endpoint — SITE_ADDRESS TLS'ga o'tganda ham ishlaydi.
:8080 {
	respond /healthz "OK" 200
}
